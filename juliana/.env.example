# ---------------------------------------------------------------- catalogo
# URL do feed XML do Google Shopping da loja.
# Se ficar vazia, a ingestao le data/feed.xml, que e o caminho para quando a
# cliente entrega o arquivo exportado em vez da URL.
FEED_URL=

# Uma requisicao isolada ao feed devolve cerca de 150 itens e o catalogo tem
# 927, entao a ingestao pagina ate esgotar.
# auto    = tenta page e depois offset, fica com o que trouxer mais itens
# page    = usa ?page=N
# offset  = usa ?offset=N&limit=L
# nenhum  = uma requisicao so (use apenas se o feed ja vier completo)
FEED_MODO_PAGINACAO=auto
FEED_PARAM_PAGINA=page
FEED_PARAM_OFFSET=offset
FEED_PARAM_LIMITE=limit
FEED_TAMANHO_PAGINA=150
FEED_MAX_PAGINAS=60
# A ingestao falha de forma visivel abaixo deste total, para nunca indexar
# meio catalogo em silencio.
FEED_MINIMO_OBRAS=800

# ---------------------------------------------------------------- modelo
# NUNCA colocar esta chave no front nem dentro da tag do GTM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high. Atendimento de chat pede latencia baixa.
ANTHROPIC_ESFORCO=low
ANTHROPIC_MAX_TOKENS=2048

# ---------------------------------------------------------------- servico
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=https://juliana.multiplosmm.com.br
LOG_LEVEL=info

# Numero do consultor humano, com codigo do pais. Ex.: 5511999999999
WHATSAPP_NUMERO=

# ---------------------------------------------------------------- seguranca
ALLOWED_ORIGINS=https://www.multiplosmm.com.br,https://multiplosmm.com.br
RATE_LIMIT_SESSAO=30
RATE_LIMIT_IP_HORA=60
MAX_UPLOAD_BYTES=8388608

# ---------------------------------------------------------------- composicao
COMPOSE_LADO_MAIOR_PX=2000
COMPOSE_VALIDADE_DIAS=30

# ---------------------------------------------------------------- conversa
MAX_TURNOS=20
MINUTOS_ATE_ENCERRAR=30
