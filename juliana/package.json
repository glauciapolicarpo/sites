{
  "name": "juliana",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Consultora de arte por IA da Multiplos Mayer Mizrahi: catalogo real, busca e ambientacao em escala real.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "ingest": "tsx src/ingest/index.ts",
    "build:widget": "node widget/build.mjs",
    "build": "npm run build:widget",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "limpeza": "tsx scripts/limpeza.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "better-sqlite3": "^11.7.0",
    "fast-xml-parser": "^4.5.1",
    "fastify": "^5.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
